// MATHMON: should the on-screen touch buttons show? Phones/tablets (touch-first) yes, desktops no.
// Add ?touch=1 to the URL to force them on, ?touch=0 to force them off.
function mathmon_is_mobile() {
    const q = location.search
    if (q.includes("touch=1")) return true
    if (q.includes("touch=0")) return false
    const coarse = window.matchMedia && window.matchMedia("(pointer: coarse)").matches
    return coarse || /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent)
}
window.mathmon_is_mobile = mathmon_is_mobile

function show_infobox() {
    infobox.style.display = "block";

    // Measure box
    const w = infobox.offsetWidth;
    const h = infobox.offsetHeight;

    // Center in viewport
    const left = (window.innerWidth - w) / 2;
    const top = (window.innerHeight - h) / 2;

    infobox.style.left = left + "px";
    infobox.style.top = top + "px";
}

</script>

