    <div id="mm-tip">
        To play <b>full screen</b> on iPhone:<br>
        tap <b>Share</b> &#x2191; then <b>Add to Home Screen</b>,<br>
        and open <b>MATHMON</b> from your Home Screen.<br>
        <small>(Apple doesn't let web pages hide Safari's bars.)</small><br>
        <button id="mm-tip-ok">OK</button>
    </div>
    <script>
    // MATHMON: full screen on phones. Android/iPad: the Fullscreen API (first tap, or the button).
    // iPhone Safari has no Fullscreen API for pages - "Add to Home Screen" opens it like an app.
    (function () {
        const root = document.documentElement
        const standalone = () => window.navigator.standalone === true ||
            (window.matchMedia && window.matchMedia("(display-mode: fullscreen), (display-mode: standalone)").matches)
        const isFull = () => !!(document.fullscreenElement || document.webkitFullscreenElement)
        const iPhone = /iPhone|iPod/i.test(navigator.userAgent)
        // iPhone Safari reports no page full screen (fullscreenEnabled is false there).
        const canFull = () => !iPhone && !!(document.fullscreenEnabled || document.webkitFullscreenEnabled) &&
            !!(root.requestFullscreen || root.webkitRequestFullscreen)
        const button = document.getElementById("mm-full")
        const tip = document.getElementById("mm-tip")
        function goFull() {
            if (isFull() || standalone()) return
            if (!canFull()) { tip.style.display = "block"; return }
            const request = root.requestFullscreen ? root.requestFullscreen({ navigationUI: "hide" })
                                                   : root.webkitRequestFullscreen()
            Promise.resolve(request).then(() => {
                if (screen.orientation && screen.orientation.lock) screen.orientation.lock("landscape").catch(() => {})
            }).catch(() => { if (iPhone) tip.style.display = "block" })
        }
        function refresh() {
            button.style.display = (window.mathmon_is_mobile() && !isFull() && !standalone()) ? "block" : "none"
        }
        button.addEventListener("click", (e) => { e.stopPropagation(); goFull() })
        document.getElementById("mm-tip-ok").addEventListener("click", (e) => {
            e.stopPropagation(); tip.style.display = "none"
        })
        // The first tap on the game switches to full screen where the browser allows it.
        let tried = false
        window.addEventListener("pointerdown", () => {
            if (tried || !window.mathmon_is_mobile() || !canFull()) return
            tried = true
            goFull()
        }, { capture: true })
        document.addEventListener("fullscreenchange", refresh)
        document.addEventListener("webkitfullscreenchange", refresh)
        window.addEventListener("resize", refresh)
        window.addEventListener("load", refresh)
        refresh()
    })()
    </script>

